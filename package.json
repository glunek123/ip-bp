{
  "name": "dev-cor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.27.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dev-cor/frontend --filter @dev-cor/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm test:context && pnpm -r test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "context:check": "node scripts/context-memory.mjs check",
    "context:record": "node scripts/context-memory.mjs record",
    "spec:check": "node scripts/spec-check.mjs",
    "test:context": "vitest run --config vitest.tools.config.mjs",
    "verify": "pnpm context:check && pnpm spec:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.70.0",
    "eslint-plugin-vue": "10.11.0",
    "vue-eslint-parser": "10.4.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "@types/node": "24.13.4",
    "@playwright/test": "1.63.0",
    "vitest": "4.1.11",
    "vite": "7.3.6"
  }
}

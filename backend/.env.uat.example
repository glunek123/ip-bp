# OPS-UAT-001: configuration template only; every REPLACE value must be supplied.
# Do not copy values from development/test .env files or technical acceptance accounts.
# Use a dedicated UAT instance/database/role. Never target 15438, 15439, dev_cor or dev_cor_test.
# The host and 5432 server port below are placeholders, not an allocated deployment.
NODE_ENV=production
PORT=REPLACE_UAT_BACKEND_PORT_1_TO_65535
DATABASE_URL=postgresql://REPLACE_UAT_APP_ROLE:REPLACE_URL_ENCODED_UAT_PASSWORD@uat-db.invalid:5432/dev_cor_uat
AUTH_THROTTLE_SECRET=REPLACE_WITH_UAT_ONLY_RANDOM_HEX_AT_LEAST_64_CHARACTERS
TRUST_PROXY_HOPS=REPLACE_WITH_ACTUAL_TRUSTED_PROXY_HOPS_0_TO_10
PRIVATE_FILE_ROOT=REPLACE_WITH_ABSOLUTE_NONPUBLIC_UAT_PRIVATE_FILE_ROOT
# Do not set E2E_IDENTITY_FIXTURES: production mode explicitly rejects it.
# Production storage stays unavailable unless the optional driver is explicitly set.
# For the approved single-instance UAT option only, after the future rented server,
# persistent private directory, permissions and real configuration are confirmed:
# PRIVATE_BLOB_STORAGE_DRIVER=local
# This commented example does not enable storage or deploy anything.

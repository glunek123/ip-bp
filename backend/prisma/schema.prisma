model AuditEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  departmentId       String               @map("department_id") @db.Uuid
  actorUserId        String               @map("actor_user_id") @db.Uuid
  resourceType       String               @map("resource_type")
  resourceId         String               @map("resource_id") @db.Uuid
  action             String
  details            Json?
  department         Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actorMembership    DepartmentMembership @relation("AuditActorMembership", fields: [actorUserId, departmentId], references: [userId, departmentId], onDelete: Restrict)
  materialReferences MaterialReference[]
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([departmentId, resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PermissionAction {
  CUSTOMER_READ                @map("customer.read")
  CUSTOMER_CREATE_DRAFT        @map("customer.create-draft")
  CUSTOMER_EDIT_ROUTINE        @map("customer.edit-routine")
  CUSTOMER_ADMIT               @map("customer.admit")
  LEAD_READ                    @map("lead.read")
  LEAD_CREATE                  @map("lead.create")
  LEAD_EDIT                    @map("lead.edit")
  LEAD_PUSH                    @map("lead.push")
  LEAD_WITHDRAW_APPLY          @map("lead.withdraw.apply")
  LEAD_EVIDENCE_DECIDE         @map("lead.evidence.decide")
  NOTARY_OFFICE_MANAGE         @map("notary.office.manage")
  CLIENT_LEAD_READ             @map("client.lead.read")
  CLIENT_LEAD_REVIEW           @map("client.lead.review")
  CLIENT_LEAD_WITHDRAW_CONFIRM @map("client.lead.withdraw.confirm")
  USER_READ                    @map("user.read")
  USER_MANAGE                  @map("user.manage")
  TEAM_READ                    @map("team.read")
  TEAM_MANAGE                  @map("team.manage")
  ROLE_READ                    @map("role.read")
  ROLE_ASSIGN                  @map("role.assign")
  ROLE_MANAGE                  @map("role.manage")

  @@map("permission_action")
}

enum UserAccountType {
  INTERNAL
  CLIENT

  @@map("user_account_type")
}

enum PermissionScope {
  SELF
  TEAM
  DEPARTMENT

  @@map("permission_scope")
}

enum CustomerProfileStatus {
  DRAFT
  ADMITTED

  @@map("customer_profile_status")
}

enum IdentityValidityMode {
  FIXED
  LONG_TERM
  NOT_STATED

  @@map("identity_validity_mode")
}

enum UploadDraftStatus {
  OPEN
  FINALIZED
  EXPIRED

  @@map("upload_draft_status")
}

enum MaterialOwnerType {
  CUSTOMER
  LEAD_DRAFT
  LEAD

  @@map("material_owner_type")
}

enum MaterialCategory {
  CUSTOMER_IDENTITY
  LEAD_SCREENSHOT

  @@map("material_category")
}

enum MaterialStatus {
  ACTIVE
  DELETED

  @@map("material_status")
}

enum ContentVersionStatus {
  AVAILABLE
  DELETED
  PURGED

  @@map("content_version_status")
}

enum LeadStatus {
  WAITING_PUSH
  WAITING_REVIEW
  WAITING_EVIDENCE_DECISION
  TRANSFERRED_TO_NOTARY
  ARCHIVED

  @@map("lead_status")
}

enum NotaryOfficeStatus {
  ACTIVE
  INACTIVE

  @@map("notary_office_status")
}

enum NotaryMatterStage {
  PENDING_EVIDENCE

  @@map("notary_matter_stage")
}

enum NotaryEvidenceMode {
  ONLINE_PURCHASE

  @@map("notary_evidence_mode")
}

enum NotarySourceType {
  LEAD

  @@map("notary_source_type")
}

enum LeadReviewResult {
  INFRINGEMENT
  NO_INFRINGEMENT

  @@map("lead_review_result")
}

enum LeadArchiveType {
  NO_INFRINGEMENT
  NO_EVIDENCE

  @@map("lead_archive_type")
}

enum LeadEvidenceResult {
  NO_EVIDENCE

  @@map("lead_evidence_result")
}

enum LeadCaseType {
  CIVIL
  CRIMINAL
  ADMINISTRATIVE
  INVESTIGATION
  NOTARIZATION
  HEARING_REPRESENTATION

  @@map("lead_case_type")
}

enum InfringementType {
  TRADEMARK
  SOFTWARE_COPYRIGHT
  ART_COPYRIGHT
  AUDIOVISUAL_COPYRIGHT
  TEXT_COPYRIGHT
  INVENTION_PATENT
  DESIGN_PATENT
  UTILITY_MODEL_PATENT
  UNFAIR_COMPETITION
  NETWORK_DISSEMINATION
  PORTRAIT_RIGHT
  OTHER

  @@map("infringement_type")
}

enum LeadSource {
  ONLINE
  OFFLINE

  @@map("lead_source")
}

enum LeadPlatform {
  TAOBAO
  TMALL
  PINDUODUO
  JD
  DOUYIN
  ALIBABA_1688
  XIAOHONGSHU
  KUAISHOU
  XIANYU
  WECHAT
  MEITUAN
  DIANPING
  MAP
  OTHER

  @@map("lead_platform")
}

enum LeadCreationChannel {
  MANUAL
  OCR
  CRAWLER
  CSV
  HISTORICAL

  @@map("lead_creation_channel")
}

enum TeamStatus {
  ACTIVE
  INACTIVE

  @@map("team_status")
}

model Department {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  memberships                 DepartmentMembership[]
  roleTemplates               RoleTemplate[]
  roleAssignments             RoleAssignment[]
  customers                   Customer[]
  rightsHolders               RightsHolder[]
  customerRightsHolderLinks   CustomerRightsHolderLink[]
  rightsHolderCommandReceipts RightsHolderCommandReceipt[]
  auditEvents                 AuditEvent[]
  authSessions                AuthSession[]
  teams                       Team[]
  uploadDrafts                UploadDraft[]
  materials                   Material[]
  materialReferences          MaterialReference[]
  customerAdmissionReceipts   CustomerAdmissionReceipt[]
  leads                       Lead[]
  notaryOffices               NotaryOffice[]
  notaryMatters               NotaryMatter[]
  leadCommandReceipts         LeadCommandReceipt[]
  clientAccountBindings       CustomerAccountBinding[]
  leadReviewDecisions         LeadReviewDecision[]
  clientLeadReviewReceipts    ClientLeadReviewReceipt[]
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("departments")
}

model Team {
  id              String                 @id @default(uuid()) @db.Uuid
  departmentId    String                 @map("department_id") @db.Uuid
  name            String
  status          TeamStatus             @default(ACTIVE)
  department      Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships     DepartmentMembership[]
  roleAssignments RoleAssignment[]
  customers       Customer[]
  leads           Lead[]
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, departmentId])
  @@index([departmentId, status])
  @@map("teams")
}

model UserAccount {
  id                    String                    @id @default(uuid()) @db.Uuid
  externalSubject       String                    @unique @map("external_subject")
  displayName           String                    @map("display_name")
  active                Boolean                   @default(true)
  accountType           UserAccountType           @default(INTERNAL) @map("account_type")
  authorizationRevision Int                       @default(1) @map("authorization_revision")
  localCredential       LocalCredential?
  authSessions          AuthSession[]
  memberships           DepartmentMembership[]
  roleAssignments       RoleAssignment[]
  uploadedContent       ContentVersion[]
  clientBinding         CustomerAccountBinding?
  pushedLeads           Lead[]                    @relation("LeadPushedBy")
  reviewedLeadDecisions LeadReviewDecision[]      @relation("LeadReviewDecisionReviewer")
  evidenceDecisions     LeadEvidenceDecision[]    @relation("LeadEvidenceDecisionActor")
  createdNotaryOffices  NotaryOffice[]             @relation("NotaryOfficeCreator")
  createdNotaryMatters  NotaryMatter[]             @relation("NotaryMatterCreator")
  clientReviewReceipts  ClientLeadReviewReceipt[] @relation("ClientLeadReviewReceiptActor")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_accounts")
}

model LocalCredential {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @unique @map("user_id") @db.Uuid
  username          String      @unique
  passwordHash      String      @map("password_hash")
  passwordChangedAt DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  user              UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("local_credentials")
}

model AuthSession {
  id                    String      @id @default(uuid()) @db.Uuid
  tokenDigest           String      @unique @map("token_digest") @db.Char(64)
  csrfDigest            String      @map("csrf_digest") @db.Char(64)
  userId                String      @map("user_id") @db.Uuid
  departmentId          String      @map("department_id") @db.Uuid
  authorizationRevision Int         @map("authorization_revision")
  expiresAt             DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt             DateTime?   @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt            DateTime    @default(now()) @map("last_used_at") @db.Timestamptz(3)
  user                  UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)
  department            Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([departmentId, expiresAt])
  @@map("auth_sessions")
}

model AuthThrottle {
  id               String    @id @default(uuid()) @db.Uuid
  kind             String
  identifierDigest String    @map("identifier_digest") @db.Char(64)
  failureCount     Int       @default(0) @map("failure_count")
  windowStartedAt  DateTime  @map("window_started_at") @db.Timestamptz(3)
  blockedUntil     DateTime? @map("blocked_until") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([kind, identifierDigest])
  @@index([blockedUntil])
  @@map("auth_throttles")
}

model DepartmentMembership {
  id                          String                       @id @default(uuid()) @db.Uuid
  userId                      String                       @map("user_id") @db.Uuid
  departmentId                String                       @map("department_id") @db.Uuid
  teamId                      String?                      @map("team_id") @db.Uuid
  active                      Boolean                      @default(true)
  user                        UserAccount                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  department                  Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team                        Team?                        @relation(fields: [teamId, departmentId], references: [id, departmentId], onDelete: Restrict, onUpdate: Restrict, map: "department_memberships_team_department_fkey")
  responsibleCustomers        Customer[]                   @relation("CustomerResponsibleMembership")
  rightsHolderCommandReceipts RightsHolderCommandReceipt[] @relation("RightsHolderReceiptActor")
  auditEvents                 AuditEvent[]                 @relation("AuditActorMembership")
  uploadDrafts                UploadDraft[]                @relation("UploadDraftActor")
  customerAdmissionReceipts   CustomerAdmissionReceipt[]   @relation("CustomerAdmissionReceiptActor")
  responsibleLeads            Lead[]                       @relation("LeadResponsibleMembership")
  leadCommandReceipts         LeadCommandReceipt[]         @relation("LeadCommandReceiptActor")
  withdrawalApplications      LeadWithdrawalApplication[]
  evidenceDecisions           LeadEvidenceDecision[]
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, departmentId])
  @@index([departmentId, active])
  @@map("department_memberships")
}

model RoleTemplate {
  id           String           @id @default(uuid()) @db.Uuid
  departmentId String           @map("department_id") @db.Uuid
  name         String
  active       Boolean          @default(true)
  version      Int              @default(1)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grants       RoleGrant[]
  assignments  RoleAssignment[]
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([departmentId, name])
  @@unique([id, departmentId])
  @@map("role_templates")
}

model RoleGrant {
  id             String           @id @default(uuid()) @db.Uuid
  roleTemplateId String           @map("role_template_id") @db.Uuid
  action         PermissionAction
  scope          PermissionScope
  roleTemplate   RoleTemplate     @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([roleTemplateId, action, scope])
  @@map("role_grants")
}

model RoleAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  departmentId   String       @map("department_id") @db.Uuid
  roleTemplateId String       @map("role_template_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  active         Boolean      @default(true)
  version        Int          @default(1)
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Restrict)
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roleTemplate   RoleTemplate @relation(fields: [roleTemplateId, departmentId], references: [id, departmentId], onDelete: Restrict)
  team           Team?        @relation(fields: [teamId, departmentId], references: [id, departmentId], onDelete: Restrict, onUpdate: Restrict, map: "role_assignments_team_department_fkey")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, departmentId, roleTemplateId, teamId])
  @@index([userId, departmentId, active])
  @@map("role_assignments")
}

model Customer {
  id                       String                       @id @default(uuid()) @db.Uuid
  name                     String
  normalizedName           String                       @map("normalized_name")
  customerType             String?                      @map("customer_type")
  identityType             String?                      @map("identity_type")
  identityNumber           String?                      @map("identity_number")
  normalizedIdentityNumber String?                      @map("normalized_identity_number")
  issuingCountryOrRegion   String?                      @map("issuing_country_or_region")
  category                 String?
  region                   String?
  admissionContactName     String?                      @map("admission_contact_name")
  admissionContactPhone    String?                      @map("admission_contact_phone")
  admissionContactEmail    String?                      @map("admission_contact_email")
  identityValidFrom        DateTime?                    @map("identity_valid_from") @db.Date
  identityValidTo          DateTime?                    @map("identity_valid_to") @db.Date
  identityValidityMode     IdentityValidityMode?        @map("identity_validity_mode")
  admittedAt               DateTime?                    @map("admitted_at") @db.Timestamptz(3)
  profileStatus            CustomerProfileStatus        @default(DRAFT) @map("profile_status")
  departmentId             String                       @map("department_id") @db.Uuid
  responsibleUserId        String                       @map("responsible_user_id") @db.Uuid
  teamId                   String?                      @map("team_id") @db.Uuid
  version                  Int                          @default(1)
  department               Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team                     Team?                        @relation(fields: [teamId, departmentId], references: [id, departmentId], onDelete: Restrict, onUpdate: Restrict, map: "customers_team_department_fkey")
  responsibleMembership    DepartmentMembership         @relation("CustomerResponsibleMembership", fields: [responsibleUserId, departmentId], references: [userId, departmentId], onDelete: Restrict)
  rightsHolderLinks        CustomerRightsHolderLink[]
  rightsHolderReceipts     RightsHolderCommandReceipt[] @relation("RightsHolderReceiptCustomer")
  admissionReceipts        CustomerAdmissionReceipt[]
  leads                    Lead[]
  clientAccountBindings    CustomerAccountBinding[]
  leadReviewDecisions      LeadReviewDecision[]
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([departmentId, identityType, normalizedIdentityNumber])
  @@unique([id, departmentId])
  @@index([departmentId, updatedAt, id])
  @@index([departmentId, normalizedName])
  @@index([responsibleUserId])
  @@index([teamId])
  @@map("customers")
}

model CustomerAccountBinding {
  id                      String                       @id @default(uuid()) @db.Uuid
  userId                  String                       @unique @map("user_id") @db.Uuid
  customerId              String                       @map("customer_id") @db.Uuid
  departmentId            String                       @map("department_id") @db.Uuid
  active                  Boolean                      @default(true)
  version                 Int                          @default(1)
  user                    UserAccount                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer                Customer                     @relation(fields: [customerId, departmentId], references: [id, departmentId], onDelete: Restrict, map: "customer_account_bindings_customer_department_fkey")
  department              Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  leadReviewDecisions     LeadReviewDecision[]
  clientReviewReceipts    ClientLeadReviewReceipt[]
  withdrawalConfirmations LeadWithdrawalConfirmation[]
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, userId, customerId, departmentId], map: "customer_account_bindings_review_identity_key")
  @@index([customerId, departmentId, active])
  @@map("customer_account_bindings")
}

model RightsHolder {
  id                  String                       @id @default(uuid()) @db.Uuid
  /// SQL CHECK rights_holders_name_nonblank_check uses ECMAScript trim whitespace (20260917080000).
  name                String
  credit              String?
  address             String?
  legalRepresentative String?                      @map("legal_representative")
  duty                String?
  departmentId        String                       @map("department_id") @db.Uuid
  department          Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  links               CustomerRightsHolderLink[]
  commandReceipts     RightsHolderCommandReceipt[] @relation("RightsHolderReceiptHolder")
  leads               Lead[]
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, departmentId])
  @@index([departmentId, updatedAt, id])
  @@index([departmentId, name])
  @@map("rights_holders")
}

model CustomerRightsHolderLink {
  id              String                       @id @default(uuid()) @db.Uuid
  customerId      String                       @map("customer_id") @db.Uuid
  rightsHolderId  String                       @map("rights_holder_id") @db.Uuid
  departmentId    String                       @map("department_id") @db.Uuid
  customer        Customer                     @relation(fields: [customerId, departmentId], references: [id, departmentId], onDelete: Restrict, map: "customer_rights_holder_links_customer_department_fkey")
  rightsHolder    RightsHolder                 @relation(fields: [rightsHolderId, departmentId], references: [id, departmentId], onDelete: Restrict, map: "customer_rights_holder_links_holder_department_fkey")
  department      Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  commandReceipts RightsHolderCommandReceipt[] @relation("RightsHolderReceiptLink")
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([id, departmentId])
  @@unique([customerId, rightsHolderId], map: "customer_rights_holder_links_customer_holder_key")
  @@index([departmentId, rightsHolderId])
  @@map("customer_rights_holder_links")
}

model RightsHolderCommandReceipt {
  id                    String                   @id @default(uuid()) @db.Uuid
  departmentId          String                   @map("department_id") @db.Uuid
  actorUserId           String                   @map("actor_user_id") @db.Uuid
  action                String
  idempotencyKey        String                   @map("idempotency_key")
  requestFingerprint    String                   @map("request_fingerprint") @db.Char(64)
  resultHolderId        String                   @map("result_holder_id") @db.Uuid
  resultLinkId          String                   @map("result_link_id") @db.Uuid
  resultCustomerId      String                   @map("result_customer_id") @db.Uuid
  resultCustomerVersion Int                      @map("result_customer_version")
  department            Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actorMembership       DepartmentMembership     @relation("RightsHolderReceiptActor", fields: [actorUserId, departmentId], references: [userId, departmentId], onDelete: Restrict, map: "rights_holder_command_receipts_actor_department_fkey")
  resultHolder          RightsHolder             @relation("RightsHolderReceiptHolder", fields: [resultHolderId, departmentId], references: [id, departmentId], onDelete: Restrict, map: "rights_holder_command_receipts_holder_department_fkey")
  resultLink            CustomerRightsHolderLink @relation("RightsHolderReceiptLink", fields: [resultLinkId, departmentId], references: [id, departmentId], onDelete: Restrict, map: "rights_holder_command_receipts_link_department_fkey")
  resultCustomer        Customer                 @relation("RightsHolderReceiptCustomer", fields: [resultCustomerId, departmentId], references: [id, departmentId], onDelete: Restrict, map: "rights_holder_command_receipts_customer_department_fkey")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([departmentId, actorUserId, action, idempotencyKey], map: "rights_holder_command_receipts_department_actor_action_key")
  @@index([resultCustomerId, departmentId], map: "rh_receipts_customer_department_idx")
  @@map("rights_holder_command_receipts")
}

model UploadDraft {
  id                String               @id @default(uuid()) @db.Uuid
  departmentId      String               @map("department_id") @db.Uuid
  actorUserId       String               @map("actor_user_id") @db.Uuid
  ownerType         MaterialOwnerType    @map("owner_type")
  ownerId           String               @map("owner_id") @db.Uuid
  category          MaterialCategory
  purpose           String               @db.VarChar(100)
  originalFilename  String               @map("original_filename") @db.VarChar(200)
  declaredMimeType  String               @map("declared_mime_type") @db.VarChar(100)
  pendingStorageKey String?              @unique(map: "upload_drafts_pending_storage_key_key") @map("pending_storage_key") @db.VarChar(500)
  status            UploadDraftStatus    @default(OPEN)
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(3)
  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actorMembership   DepartmentMembership @relation("UploadDraftActor", fields: [actorUserId, departmentId], references: [userId, departmentId], onDelete: Restrict, map: "upload_drafts_actor_department_fkey")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([departmentId, ownerType, ownerId, status])
  @@index([status, expiresAt])
  @@map("upload_drafts")
}

model Material {
  id               String              @id @default(uuid()) @db.Uuid
  departmentId     String              @map("department_id") @db.Uuid
  ownerType        MaterialOwnerType   @map("owner_type")
  ownerId          String              @map("owner_id") @db.Uuid
  category         MaterialCategory
  purpose          String              @db.VarChar(100)
  currentVersionId String?             @map("current_version_id") @db.Uuid
  status           MaterialStatus      @default(ACTIVE)
  version          Int                 @default(1)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)
  department       Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  currentVersion   ContentVersion?     @relation("MaterialCurrentVersion", fields: [id, currentVersionId], references: [materialId, id], onDelete: Restrict, map: "materials_current_version_fkey")
  contentVersions  ContentVersion[]    @relation("MaterialContentVersions")
  references       MaterialReference[]
  notarySelections NotaryMatterMaterial[]
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, departmentId])
  @@index([departmentId, ownerType, ownerId, status])
  @@map("materials")
}

model ContentVersion {
  id                   String               @id @default(uuid()) @db.Uuid
  materialId           String               @map("material_id") @db.Uuid
  storageKey           String               @unique @map("storage_key") @db.VarChar(500)
  originalFilename     String               @map("original_filename") @db.VarChar(200)
  mimeType             String               @map("mime_type") @db.VarChar(100)
  sizeBytes            BigInt               @map("size_bytes")
  sha256               String               @db.Char(64)
  uploadedBy           String               @map("uploaded_by") @db.Uuid
  derivedFromVersionId String?              @map("derived_from_version_id") @db.Uuid
  status               ContentVersionStatus @default(AVAILABLE)
  material             Material             @relation("MaterialContentVersions", fields: [materialId], references: [id], onDelete: Restrict)
  currentForMaterials  Material[]           @relation("MaterialCurrentVersion")
  uploader             UserAccount          @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  derivedFromVersion   ContentVersion?      @relation("DerivedContentVersions", fields: [derivedFromVersionId], references: [id], onDelete: Restrict)
  derivedVersions      ContentVersion[]     @relation("DerivedContentVersions")
  materialReferences   MaterialReference[]
